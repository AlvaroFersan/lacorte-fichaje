# Copia este archivo a .env para probar en el PC.
# En el NAS no hace falta este archivo: el contenedor genera
# session.secret dentro de /volume1/docker/lacorte/data.

# En el PC: http://localhost:3000
# En el NAS (Docker) se publica 3001 por fuera; dentro del contenedor es 3000.
PUERTO=3000

# En Docker debe ser /data/fichaje.db (el compose lo pone solo).
# En el PC, sin Docker, deja esta ruta:
RUTA_DB=./data/fichaje.db

# Frase larga y aleatoria para firmar las cookies.
# El script preparar-nas la genera. No dejes el valor de ejemplo.
SESSION_SECRET=cambia-esta-frase-por-una-aleatoria-larga

# En el NAS se entra por http (sin certificado). Déjalo en 0.
# Pon 1 solo si sirves la app con HTTPS.
COOKIE_SECURE=0

# En el NAS y en Docker: production
NODE_ENV=production

# Solo en el PC, para scripts/poner-clave.js. No lo subas ni lo pongas en el NAS.
# CLAVE_ALVARO=
